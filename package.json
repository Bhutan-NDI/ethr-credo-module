{
  "name": "@bhutan-ndi/ethr-credo-module",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "version": "1.0.3",
  "files": [
    "build"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Bhutan-NDI/ethr-credo-module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bhutan-NDI/ethr-credo-module"
  },
  "scripts": {
    "build": "yarn run clean && yarn run compile",
    "clean": "rimraf -rf ./build",
    "compile": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/abi','build/abi',{recursive:true})\"",
    "prepublishOnly": "yarn run build",
    "check-types": "tsc --noEmit -p tsconfig.build.json",
    "check-format": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "lint": "eslint --ignore-path .gitignore .",
    "release": "yarn build && yarn changeset publish --no-git-tag",
    "changeset-version": "yarn changeset version && yarn prettier --write ."
  },
  "dependencies": {
    "axios": "^1.6.3",
    "did-resolver": "^4.1.0",
    "ethers": "^6.9.0",
    "ethr-did": "^3.0.38",
    "ethr-did-resolver": "~11.0.4",
    "keccak256": "^1.0.6"
  },
  "peerDependencies": {
    "@credo-ts/askar": "^0.6.1",
    "@credo-ts/core": "^0.6.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@credo-ts/askar": "0.6.3",
    "@credo-ts/core": "0.6.3",
    "@credo-ts/node": "0.6.3",
    "@openwallet-foundation/askar-nodejs": "^0.4.3",
    "@types/node": "^18.18.8",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-import-resolver-typescript": "^3.5.5",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^4.2.1",
    "prettier": "^2.2.1",
    "reflect-metadata": "^0.2.1",
    "rimraf": "^4.4.0",
    "rxjs": "^7.8.1",
    "ts-node": "^10.8.1",
    "tsconfig-paths": "^4.1.2",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "yarn@1.22.22"
}
